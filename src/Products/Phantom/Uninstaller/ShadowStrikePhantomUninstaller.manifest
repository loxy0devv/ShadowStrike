<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  ShadowStrike - Enterprise NGAV/EDR Platform
  Copyright (C) 2026 ShadowStrike Security

  ShadowStrikePhantomUninstaller.manifest
  Embedded as RT_MANIFEST (resource ID 1) by the linker via the .vcxproj
  EmbedManifest / ManifestFile settings.

  requireAdministrator — the uninstaller MUST run elevated; Windows will
  trigger a UAC consent prompt automatically before the process starts.
  No elevation-check code is needed at runtime for the UAC gate, but the
  implementation also verifies token elevation as a belt-and-suspenders
  guard against manifest tampering.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">

  <assemblyIdentity
    version="1.0.0.0"
    processorArchitecture="amd64"
    name="ShadowStrike.Phantom.Uninstaller"
    type="win32"
  />

  <description>ShadowStrike Phantom Uninstaller</description>

  <!-- UAC elevation: requireAdministrator ensures the shell elevates before
       the process image is created, so the uninstaller always runs as a
       high-integrity administrator token. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel
          level="requireAdministrator"
          uiAccess="false"
        />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- Windows 10 / 11 DPI awareness and common controls v6 -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">
        true/PM
      </dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">
        PerMonitorV2, PerMonitor
      </dpiAwareness>
    </windowsSettings>
  </application>

  <!-- Common controls v6 (visual styles, progress bar, etc.) -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="amd64"
        publicKeyToken="6595b64144ccf1df"
        language="*"
      />
    </dependentAssembly>
  </dependency>

  <!-- Compatibility GUIDs — Windows 10 and 11 -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
    </application>
  </compatibility>

</assembly>
