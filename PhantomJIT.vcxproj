<?xml version="1.0" encoding="utf-8"?>
<!--
  PhantomJIT.vcxproj
  Compiles the JIT translation unit with clang-cl instead of MSVC.

  Rationale: JITCompiler.cpp + JITOptimizer.cpp generate extremely large
  template instantiation trees under /O2.  MSVC (even HostX64) exhausts its
  compiler heap on CI runners (7 GB).  clang-cl handles the same code with
  dramatically lower peak RSS because its code-gen pipeline is more memory-
  efficient and it does not accumulate the whole-TU IR that MSVC's /GL requires.

  Output: lib\<Config>\PhantomJIT.lib
  Consumer: PhantomCoreLib.vcxproj merges this lib into PhantomCoreLib.lib via
            a post-build lib.exe step, so downstream projects need no changes.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}</ProjectGuid>
    <RootNamespace>PhantomJIT</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <!-- ── Debug ─────────────────────────────────────────────────────────────── -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>ClangCL</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>

  <!-- ── Release ───────────────────────────────────────────────────────────── -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>ClangCL</PlatformToolset>
    <!-- LTO is intentionally off: MSVC LTCG and clang LTO use incompatible
         IR formats; the merged lib must be linkable by an MSVC linker. -->
    <WholeProgramOptimization>false</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <!-- ── Output paths (mirror PhantomCoreLib conventions) ─────────────────── -->
  <PropertyGroup>
    <OutDir>$(SolutionDir)lib\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)build\$(Configuration)\PhantomJIT\</IntDir>
    <TargetName>PhantomJIT</TargetName>
  </PropertyGroup>

  <!-- ── Debug compile settings ────────────────────────────────────────────── -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
      <ExceptionHandling>Sync</ExceptionHandling>
      <LanguageStandard>stdcpplatest</LanguageStandard>
      <AdditionalIncludeDirectories>$(SolutionDir);$(SolutionDir)include;$(SolutionDir)include\YARA;$(SolutionDir)src;$(SolutionDir)PhantomEmulator;$(SolutionDir)vendor\onnxruntime\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>_DEBUG;WIN32;_WINDOWS;UNICODE;_UNICODE;NOMINMAX;WIN32_LEAN_AND_MEAN;PHANTOM_EMULATOR_AVAILABLE;SHADOWSTRIKE_HAS_ONNXRUNTIME=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- ── Release compile settings ──────────────────────────────────────────── -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <ExceptionHandling>Sync</ExceptionHandling>
      <LanguageStandard>stdcpplatest</LanguageStandard>
      <AdditionalIncludeDirectories>$(SolutionDir);$(SolutionDir)include;$(SolutionDir)include\YARA;$(SolutionDir)src;$(SolutionDir)PhantomEmulator;$(SolutionDir)vendor\onnxruntime\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>NDEBUG;WIN32;_WINDOWS;UNICODE;_UNICODE;NOMINMAX;WIN32_LEAN_AND_MEAN;PHANTOM_EMULATOR_AVAILABLE;SHADOWSTRIKE_HAS_ONNXRUNTIME=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalOptions>-Wno-unused-value -Wno-microsoft-cast -Wno-ignored-attributes -Wno-deprecated-declarations %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Lib>
      <OutputFile>$(OutDir)$(TargetName).lib</OutputFile>
    </Lib>
  </ItemDefinitionGroup>

  <!-- ── Source files ──────────────────────────────────────────────────────── -->
  <ItemGroup>
    <ClCompile Include="PhantomEmulator\Core\JIT\JITCompiler.cpp" />
    <ClCompile Include="PhantomEmulator\Core\JIT\JITOptimizer.cpp" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

</Project>
